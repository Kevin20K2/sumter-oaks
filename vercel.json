{
  "rewrites": [
    {
      "source": "/",
      "destination": "/viewer/index.html"
    },
    {
      "source": "/classic",
      "destination": "/viewer/classic.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
